# Copie para .env.local (rodar no computador) ou cadastre em Vercel → Settings → Environment Variables.

# Obrigatório: chave do Groq (console.groq.com → API Keys)
GROQ_API_KEY=

# Opcional: modelo do Groq. Veja a lista em /api/health depois de rodar.
GROQ_MODEL=openai/gpt-oss-120b

# Conta de serviço do Google (JSON inteiro da chave, em uma linha). Sem isso, o app usa a cópia local da pasta base/.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Pasta "Vértice - Base RH" e planilha "Guia Vértice - Registros" (já vêm preenchidas no código)
DRIVE_FOLDER_ID=1ltkS6k1EoGDgoVRN9WTUuqjN_HUthxE9
SHEETS_ID=109EH6_8RWqRbM9sPi6Rg7oasLBaHOZY0xKmeUM9TnXM

# Opcional: senha do Painel do RH
RH_SENHA=
